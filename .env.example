# Copy to .env.local and fill in. Never commit .env.local.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:devpass@localhost:55432/editor_performance

# Shared-password gate (v1). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=
SESSION_SECRET=          # >= 32 chars
CRON_SECRET=             # >= 16 chars; Vercel Cron sends it as a Bearer token

# --- Data sources -----------------------------------------------------------
# true = serve fixture data. Keep true until the Phase 0 spikes complete
# (docs/phase-0-access.md).
USE_FIXTURES=true

# Meta Marketing API (Phase 0a)
# META_ACCESS_TOKEN=
# META_API_VERSION=v21.0
# Which action type carries purchase value. The two candidates differ
# materially and the error is invisible — confirm against real data first.
# META_PURCHASE_ACTION_TYPE=omni_purchase

# Pipes API (Phase 0b)
# PIPES_API_BASE=
# PIPES_API_KEY=
# Enable ONLY if the spike proved UTM content carries the ad name consistently
# across all ten accounts. Guessing mis-attributes revenue between editors.
# PIPES_ALLOW_UTM_FALLBACK=false

# --- Ads Manager links ------------------------------------------------------
# Capture BY HAND from a working filtered view — see docs/ads-manager-urls.md.
# Placeholders: {ACCOUNT_ID} {START} {END} and, for the editor template, {TOKEN}.
# ADS_MANAGER_ACCOUNT_URL_TEMPLATE=
# ADS_MANAGER_EDITOR_URL_TEMPLATE=
